# Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Simple app-level passcode gate (leave blank to disable the gate entirely)
VITE_APP_PASSCODE=choose-a-passcode

# Where the "Blog" nav item opens to create a new post (Sanity Studio's
# create-new-document intent link for the marketing site). Optional — falls
# back to the current site URL if unset. Update this once the custom domain
# (ssyogaretreats.com) is live instead of the vercel.app preview URL.
VITE_BLOG_STUDIO_URL=https://site-rho-five-7qjhp19rc8.vercel.app/studio/intent/create/type=post
